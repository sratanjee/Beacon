# Beacon — environment variables
# Copy to .env.local for local dev, and add to Vercel project settings for prod.

# Public — safe to expose in the browser bundle
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Cron auth — long random string. Vercel Cron sends the value as Bearer <secret>.
CRON_SECRET=

# Site password gate (Phase 3). Long random string; set in Vercel too.
SITE_PASSWORD=

# Anthropic API key with access to Haiku 4.5 + Sonnet 4.6 (Phase 3 scoring + PDF extract)
ANTHROPIC_API_KEY=
